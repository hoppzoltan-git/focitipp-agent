# Anthropic API-kulcs (console.anthropic.com) – a kutatáshoz és az elemzésekhez
ANTHROPIC_API_KEY=
# Az oldal jelszava (a felhasználónév bármi lehet)
APP_PASSWORD=
# A napi Vercel Cron védelme (hosszú, véletlenszerű szöveg)
CRON_SECRET=
# Vercel Blob – automatikusan beállítódik, ha a Blob tárhely a projekthez van kötve
BLOB_READ_WRITE_TOKEN=
# Opcionális: más Claude-modell
# ANTHROPIC_MODEL=claude-sonnet-5-5
